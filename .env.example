# BankMCP Security Environment Configuration

# Server Ports
PORT=8080
MCP_TRANSPORT=sse

# Admin Dashboard Credentials (DMCPS Style)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_strong_password_123

# API Key for MCP Clients (Leave blank to auto-generate)
MCP_API_KEY=

# Spending Rails Defaults (USD / EUR / Local)
MAX_TRANSACTION_LIMIT=500
MAX_DAILY_LIMIT=2000
REQUIRE_HUMAN_APPROVAL_ABOVE=100

# Data storage path for whitelist & ledger
DATA_DIR=./data

